DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sportsiq?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
SUPERADMIN_EMAIL="admin@sportsiq.in"
SUPERADMIN_PASSWORD="ChangeMe@123"

# Payments (Razorpay). Leave empty to use labelled TEST mode in development.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
PAYMENTS_TEST_MODE=true

# Public URL of the web app (used in email links)
APP_URL="http://localhost:5173"

# Email (SMTP). Leave SMTP_HOST empty in development: emails are recorded in the Super Admin "Email Outbox".
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="SportsIQ <no-reply@sportsiq.in>"

# File storage. Local folder by default; set S3_BUCKET to use S3 / R2 / Spaces / MinIO.
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=5
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ENDPOINT=""
S3_PUBLIC_URL=""   # e.g. https://cdn.sportsiq.in  (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY via environment)

# Security
TRUST_PROXY=1            # number of reverse proxies in front of the API (for correct client IPs)
DISABLE_RATE_LIMIT=false # only for automated tests

# GST invoices for platform subscriptions (confirm rate & SAC with your CA)
PLATFORM_LEGAL_NAME=""
PLATFORM_GSTIN=""
PLATFORM_STATE="Maharashtra"
PLATFORM_ADDRESS=""
PLATFORM_SAC="998315"
GST_RATE=18
