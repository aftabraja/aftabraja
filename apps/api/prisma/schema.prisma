// SportsIQ data model
// Multi-sport ready: League.sport is free text today, enum-able later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  LEAGUE_OWNER
  LEAGUE_STAFF
  TEAM_OWNER
  PLAYER
  VENDOR
  SPONSOR
  TALENT_AGENT
}

enum LeagueStatus {
  DRAFT
  PLANNING
  REGISTRATION_OPEN
  LIVE
  COMPLETED
  CANCELLED
}

enum StepStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  SKIPPED
}

enum RegistrationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  SOLD
  UNSOLD
}

enum OpportunityStatus {
  OPEN
  IN_DISCUSSION
  SOLD
  CLOSED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role
  avatarUrl    String?
  isActive     Boolean  @default(true)
  acceptedTermsAt DateTime?
  deletionRequestedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedLeagues      League[]             @relation("LeagueOwner")
  leagueMemberships LeagueMember[]
  teamOwnerships    TeamOwner[]
  playerProfile     PlayerProfile?
  vendorProfile     VendorProfile?
  sponsorProfile    SponsorProfile?
  agencyProfile     AgencyProfile?
  talentEnquiries   TalentEnquiry[]
  notifications     Notification[]
  participants      ConversationParticipant[]
  messages          Message[]
  subscriptions     Subscription[]
  auditLogs         AuditLog[]
  tokens            AuthToken[]
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String // LEAGUE_OWNER, TEAM_OWNER, VENDOR, SPONSOR, PLAYER
  amount    Int // INR
  status    String   @default("TRIAL") // TRIAL, ACTIVE, EXPIRED
  validTill DateTime
  createdAt DateTime @default(now())
}

model League {
  id          String       @id @default(cuid())
  name        String
  shortCode   String?
  slug        String       @unique
  sport       String       @default("Cricket")
  format      String? // T10, T20, ODI, Indoor, Corporate
  category    String? // Open, Corporate, Celebrity, State, School
  city        String?
  country     String       @default("India")
  description String?
  logoUrl     String?
  primaryColor String?     @default("#1d4ed8")
  startDate   DateTime?
  endDate     DateTime?
  numTeams    Int          @default(0)
  teamPurse   Int? // INR
  expenseApprovalLimit Int? // staff expenses above this need owner approval
  status      LeagueStatus @default(DRAFT)
  isPublic    Boolean      @default(true)
  ownerId     String
  owner       User         @relation("LeagueOwner", fields: [ownerId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members       LeagueMember[]
  teams         Team[]
  stepProgress  LeagueStepProgress[]
  registrations PlayerRegistration[]
  opportunities SponsorshipOpportunity[]
  expenses      Expense[]
  incomes       Income[]
  budgets       BudgetLine[]
  conversations Conversation[]
  decks         Deck[]
  contracts     Contract[]
  venues        Venue[]
  matches       Match[]
  auction       Auction?
  trials        TrialEvent[]
  hotels        Hotel[]
  travel        TravelBooking[]
  ticketCategories TicketCategory[]
  accredConfig  AccredConfig?
  accredZones   AccredZone[]
  accredCategories AccredCategory[]
  accreditations Accreditation[]
}

model LeagueMember {
  id         String   @id @default(cuid())
  leagueId   String
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department String // Operations, Finance, Marketing, Legal, Cricket Operations, Branding, Commercial, Logistics, Admin
  title      String?
  createdAt  DateTime @default(now())

  @@unique([leagueId, userId])
}

model LeagueStepProgress {
  id          String     @id @default(cuid())
  leagueId    String
  league      League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  stepKey     String
  status      StepStatus @default(NOT_STARTED)
  notes       String?
  attachments String[]   @default([])
  updatedAt   DateTime   @updatedAt

  @@unique([leagueId, stepKey])
}

model Team {
  id        String   @id @default(cuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  name      String
  shortName String?
  city      String?
  logoUrl   String?
  color     String?
  purse     Int?
  franchiseFee Int?
  createdAt DateTime @default(now())

  owners  TeamOwner[]
  players PlayerRegistration[]
  homeMatches Match[] @relation("HomeMatches")
  awayMatches Match[] @relation("AwayMatches")
}

model TeamOwner {
  id       String @id @default(cuid())
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharePct Float  @default(100)

  @@unique([teamId, userId])
}

model PlayerProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dob          DateTime?
  city         String?
  state        String?
  playingRole  String? // Batter, Bowler, All-rounder, Wicket-keeper
  battingStyle String?
  bowlingStyle String?
  bio          String?
  matches      Int       @default(0)
  runs         Int       @default(0)
  wickets      Int       @default(0)
  videoUrl     String?
  createdAt    DateTime  @default(now())

  registrations PlayerRegistration[]
}

model PlayerRegistration {
  id         String             @id @default(cuid())
  leagueId   String
  league     League             @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  playerId   String
  player     PlayerProfile      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status     RegistrationStatus @default(APPLIED)
  category   String? // Icon, A, B, C, Emerging
  isOverseas Boolean            @default(false)
  basePrice  Int?
  soldPrice  Int?
  teamId     String?
  team       Team?              @relation(fields: [teamId], references: [id])
  createdAt  DateTime           @default(now())

  @@unique([leagueId, playerId])
}

model VendorCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  group       String
  suggestions String[] @default([])

  services VendorService[]
}

model VendorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String
  description  String?
  city         String?
  state        String?
  serviceAreas String[] @default([])
  gstNumber    String?
  website      String?
  phone        String?
  yearsInBusiness Int?
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())

  services VendorService[]
  expenses Expense[]
}

model VendorService {
  id          String         @id @default(cuid())
  vendorId    String
  vendor      VendorProfile  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId  String
  category    VendorCategory @relation(fields: [categoryId], references: [id])
  title       String
  description String?
  priceMin    Int?
  priceMax    Int?
  unit        String? // per match, per day, per piece, per event, lump sum
  createdAt   DateTime       @default(now())

  @@index([categoryId])
}

model SponsorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  industry    String?
  website     String?
  city        String?
  description String?
  budgetMin   Int?
  budgetMax   Int?
  createdAt   DateTime @default(now())
}

model SponsorshipOpportunity {
  id           String            @id @default(cuid())
  leagueId     String
  league       League            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  title        String
  tier         String // Title, Powered By, Associate, Jersey, On-ground, Broadcast, Digital, Hospitality
  description  String?
  price        Int
  deliverables String[]          @default([])
  slots        Int               @default(1)
  status       OpportunityStatus @default(OPEN)
  createdAt    DateTime          @default(now())
}

model BudgetLine {
  id       String @id @default(cuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  category String
  planned  Int

  @@unique([leagueId, category])
}

model Expense {
  id          String        @id @default(cuid())
  leagueId    String
  league      League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  category    String
  description String
  amount      Int
  date        DateTime      @default(now())
  status      PaymentStatus @default(PENDING)
  vendorId    String?
  vendor      VendorProfile? @relation(fields: [vendorId], references: [id])
  payee       String?
  invoiceNo   String?
  gstAmount   Int           @default(0) // GST on top of amount (input tax)
  tdsAmount   Int           @default(0) // TDS deducted at payment
  paymentMode String? // Cash, UPI, Bank transfer, Card, Cheque
  paidOn      DateTime?
  receiptUrl  String?
  notes       String?
  approval    String        @default("APPROVED") // PENDING_APPROVAL, APPROVED, REJECTED
  createdById String?
  approvedById String?
  createdAt   DateTime      @default(now())
}

model Income {
  id          String        @id @default(cuid())
  leagueId    String
  league      League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  source      String // Franchise Fee, Sponsorship, Broadcast, Ticketing, Merchandise, Registration Fee, Other
  description String
  amount      Int
  date        DateTime      @default(now())
  status      PaymentStatus @default(PENDING)
  party       String? // who pays us
  invoiceNo   String?
  gstAmount   Int           @default(0) // output GST
  paymentMode String?
  receivedOn  DateTime?
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
}

model Conversation {
  id        String   @id @default(cuid())
  subject   String?
  leagueId  String?
  league    League?  @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String?
  type      String    @default("info") // info, success, warning, alert
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
}

model Deck {
  id        String   @id @default(cuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  type      String // sponsorship, franchise, concept, broadcast, investor
  title     String
  audience  String? // e.g. sponsor name for a per-sponsor version
  slides    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contract {
  id             String    @id @default(cuid())
  leagueId       String
  league         League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  templateKey    String
  title          String
  counterparty   String?
  body           String
  status         String    @default("DRAFT") // DRAFT, UNDER_LEGAL_REVIEW, SENT, SIGNED, ARCHIVED
  acknowledgedAt DateTime? // user confirmed the "verify with a lawyer" notice
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ======================= Phase 2: Season operations =======================

model Venue {
  id       String  @id @default(cuid())
  leagueId String
  league   League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  name     String
  city     String?
  address  String?
  capacity Int?
  matches  Match[]
}

model Match {
  id            String    @id @default(cuid())
  leagueId      String
  league        League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  number        Int
  stage         String    @default("League") // League, Qualifier 1, Eliminator, Qualifier 2, Semi-final, Final
  homeTeamId    String?
  homeTeam      Team?     @relation("HomeMatches", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeamId    String?
  awayTeam      Team?     @relation("AwayMatches", fields: [awayTeamId], references: [id], onDelete: SetNull)
  homeLabel     String? // placeholder for playoffs, e.g. "1st place"
  awayLabel     String?
  venueId       String?
  venue         Venue?    @relation(fields: [venueId], references: [id], onDelete: SetNull)
  startsAt      DateTime?
  status        String    @default("SCHEDULED") // SCHEDULED, LIVE, COMPLETED, ABANDONED
  oversPerSide  Int?
  tossWinnerId  String?
  tossDecision  String? // BAT, BOWL
  homeXI        String[]  @default([])
  awayXI        String[]  @default([])
  currentInnings Int      @default(1)
  winnerTeamId  String?
  resultText    String?
  isPublished   Boolean   @default(false)
  createdAt     DateTime  @default(now())

  balls        Ball[]
  ticketCategories TicketCategory[]
}

/// Cricket: one row per legal or illegal delivery
model Ball {
  id         String   @id @default(cuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  seq        Int
  innings    Int
  battingTeamId String
  striker    String
  nonStriker String?
  bowler     String
  runs       Int      @default(0) // runs off the bat
  extraType  String? // WD, NB, B, LB
  extraRuns  Int      @default(0)
  wicket     String? // BOWLED, CAUGHT, LBW, RUN_OUT, STUMPED, HIT_WICKET, RETIRED
  dismissed  String?
  fielder    String?
  createdAt  DateTime @default(now())

  @@index([matchId, seq])
}

model Auction {
  id           String    @id @default(cuid())
  leagueId     String    @unique
  league       League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  status       String    @default("SETUP") // SETUP, LIVE, PAUSED, COMPLETED
  bidIncrement Int       @default(10000)
  timerSeconds Int       @default(30)
  minSquad     Int       @default(11)
  maxSquad     Int       @default(16)
  currentRegId String?
  currentBid   Int?
  currentTeamId String?
  endsAt       DateTime?
  updatedAt    DateTime  @updatedAt
  bids         AuctionBid[]
}

model AuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  regId     String
  teamId    String
  amount    Int
  byUserId  String?
  createdAt DateTime @default(now())
}

model TrialEvent {
  id         String   @id @default(cuid())
  leagueId   String
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  title      String
  city       String?
  venue      String?
  date       DateTime
  capacity   Int      @default(100)
  inviteOnly Boolean  @default(false)
  createdAt  DateTime @default(now())
  entries    TrialEntry[]
}

model TrialEntry {
  id          String     @id @default(cuid())
  trialId     String
  trial       TrialEvent @relation(fields: [trialId], references: [id], onDelete: Cascade)
  regId       String
  code        String     @unique
  checkedInAt DateTime?
  batting     Int?
  bowling     Int?
  fielding    Int?
  fitness     Int?
  total       Int?
  comments    String?
  createdAt   DateTime   @default(now())

  @@unique([trialId, regId])
}

model Hotel {
  id        String   @id @default(cuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  name      String
  city      String?
  address   String?
  contact   String?
  checkIn   DateTime?
  checkOut  DateTime?
  createdAt DateTime @default(now())
  rooms     RoomAllocation[]
}

model RoomAllocation {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomNo    String?
  roomType  String   @default("Twin")
  teamId    String?
  group     String? // Team name, Officials, Broadcast crew, VIP...
  occupants String[] @default([])
  checkIn   DateTime?
  checkOut  DateTime?
}

model TravelBooking {
  id         String   @id @default(cuid())
  leagueId   String
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  mode       String // FLIGHT, TRAIN, BUS, CAR
  teamId     String?
  group      String?
  travellers String[] @default([])
  fromPlace  String
  toPlace    String
  departAt   DateTime
  arriveAt   DateTime?
  carrier    String?
  reference  String? // PNR / booking ref
  status     String   @default("PLANNED") // PLANNED, BOOKED, CANCELLED
  cost       Int?
  createdAt  DateTime @default(now())
}

model TicketCategory {
  id        String   @id @default(cuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  matchId   String?
  match     Match?   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  name      String
  price     Int
  quantity  Int
  sold      Int      @default(0)
  isActive  Boolean  @default(true)
  orders    TicketOrder[]
}

model TicketOrder {
  id          String         @id @default(cuid())
  categoryId  String
  category    TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  code        String         @unique
  buyerName   String
  email       String
  phone       String?
  qty         Int
  amount      Int
  status      String         @default("PENDING") // PENDING, PAID, CANCELLED
  paymentId   String?
  checkedIn   Int            @default(0)
  createdAt   DateTime       @default(now())
}

model Payment {
  id              String   @id @default(cuid())
  userId          String?
  purpose         String // SUBSCRIPTION, TICKETS
  refId           String? // subscription id / ticket order id
  amount          Int // INR (rupees)
  currency        String   @default("INR")
  provider        String // RAZORPAY, TEST
  providerOrderId String?
  providerPaymentId String?
  status          String   @default("CREATED") // CREATED, PAID, FAILED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ======================= Accreditation =======================

model AccredConfig {
  id              String   @id @default(cuid())
  leagueId        String   @unique
  league          League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  policy          String // terms & regulations shown to applicants and printed on the card back
  backText        String
  sponsorLogoUrl  String?
  layout          String   @default("PORTRAIT") // PORTRAIT (CR80 54x86mm) / LANDSCAPE
  showIdLast4     Boolean  @default(false)
  selfApplyOpen   Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model AccredZone {
  id          String @id @default(cuid())
  leagueId    String
  league      League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  code        String // shown big on the card, e.g. "1", "2", "M"
  name        String
  description String?
  sort        Int    @default(0)

  @@unique([leagueId, code])
}

model AccredCategory {
  id             String   @id @default(cuid())
  leagueId       String
  league         League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  name           String
  letter         String // short code printed on the card, e.g. P, TO, MO
  color          String
  zones          String[] @default([]) // default zone codes
  requiresIdCheck Boolean @default(true)
  selfApply      Boolean  @default(false) // can apply through the public form
  sort           Int      @default(0)
  accreditations Accreditation[]
}

model Accreditation {
  id           String         @id @default(cuid())
  leagueId     String
  league       League         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  categoryId   String
  category     AccredCategory @relation(fields: [categoryId], references: [id])
  cardNo       Int
  code         String         @unique // QR payload: <code>
  version      Int            @default(1) // increments on reprint; older cards become invalid
  name         String
  organisation String?
  designation  String?
  email        String?
  phone        String?
  photoUrl     String?
  idType       String? // Aadhaar, Passport, PAN, Driving licence, Voter ID
  idLast4      String? // only last 4 digits are stored
  idVerified   Boolean        @default(false)
  teamId       String?
  zones        String[]       @default([])
  validFrom    DateTime?
  validTo      DateTime?
  status       String         @default("APPLIED") // APPLIED, APPROVED, PRINTED, ISSUED, REJECTED, REVOKED
  source       String         @default("LEAGUE") // LEAGUE, SELF_APPLY, BULK
  notes        String?
  printedAt    DateTime?
  issuedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  scans        AccredScan[]

  @@unique([leagueId, cardNo])
}

model AccredScan {
  id              String        @id @default(cuid())
  accreditationId String
  accreditation   Accreditation @relation(fields: [accreditationId], references: [id], onDelete: Cascade)
  zone            String
  allowed         Boolean
  reason          String?
  byUserId        String?
  createdAt       DateTime      @default(now())
}

// ======================= Talent marketplace (endorsements & legends) =======================

model AgencyProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyName  String
  kind        String   @default("Agency") // Agency, Personal manager
  city        String?
  website     String?
  description String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  talents     Talent[]
}

model Talent {
  id              String        @id @default(cuid())
  agencyId        String
  agency          AgencyProfile @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name            String
  photoUrl        String?
  status          String        @default("ACTIVE") // ACTIVE, RETIRED
  playingRole     String?
  battingStyle    String?
  bowlingStyle    String?
  country         String        @default("India")
  state           String?
  bornYear        Int?
  bio             String?
  highlights      String[]      @default([])
  teamsPlayed     String[]      @default([])
  levels          String[]      @default([]) // International, Franchise T20, Domestic, Legends leagues
  matches         Int           @default(0)
  runs            Int           @default(0)
  wickets         Int           @default(0)
  followers       Int? // combined social following
  languages       String[]      @default([])
  forEndorsement  Boolean       @default(true)
  forLeagues      Boolean       @default(false)
  forAppearances  Boolean       @default(true)
  endorseFeeMin   Int?
  endorseFeeMax   Int?
  leagueFeeMin    Int?
  leagueFeeMax    Int?
  appearanceFeeMin Int?
  appearanceFeeMax Int?
  brandRestrictions String? // e.g. "No alcohol, tobacco, betting"
  authorisedAt    DateTime? // agent confirmed written authorisation to represent this player
  isPublished     Boolean       @default(false)
  verified        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  enquiries       TalentEnquiry[]
}

model TalentEnquiry {
  id             String   @id @default(cuid())
  talentId       String
  talent         Talent   @relation(fields: [talentId], references: [id], onDelete: Cascade)
  fromUserId     String
  fromUser       User     @relation(fields: [fromUserId], references: [id], onDelete: Cascade)
  purpose        String // ENDORSEMENT, LEAGUE, APPEARANCE
  organisation   String?
  leagueId       String?
  budget         Int?
  dates          String?
  message        String
  status         String   @default("NEW") // NEW, IN_DISCUSSION, CONFIRMED, DECLINED
  conversationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ======================= Accounts & email =======================

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String // RESET, INVITE
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  html      String
  status    String // SENT, LOGGED (no SMTP configured), FAILED
  error     String?
  createdAt DateTime @default(now())
}
